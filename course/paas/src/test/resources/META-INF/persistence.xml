<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd"
             version="2.1">
  <persistence-unit name="medicalCloudCourseTest" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.medcloud.course.paas.tenant.Tenant</class>
    <class>com.medcloud.course.paas.tenant.Department</class>
    <class>com.medcloud.course.paas.tenant.DoctorProfile</class>
    <class>com.medcloud.course.paas.schedule.ScheduleSlot</class>
    <class>com.medcloud.course.paas.auth.Account</class>
    <class>com.medcloud.course.paas.appointment.Appointment</class>
    <class>com.medcloud.course.paas.consultation.ClinicalRecord</class>
    <class>com.medcloud.course.paas.order.PaymentOrder</class>
    <class>com.medcloud.course.paas.audit.AuditEvent</class>
    <class>com.medcloud.course.paas.attachment.FileMetadata</class>
    <properties>
      <property name="javax.persistence.jdbc.driver" value="org.h2.Driver"/>
      <property name="javax.persistence.jdbc.url" value="jdbc:h2:mem:course_directory;MODE=MySQL;DB_CLOSE_DELAY=-1"/>
      <property name="javax.persistence.jdbc.user" value="sa"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
    </properties>
  </persistence-unit>
</persistence>
