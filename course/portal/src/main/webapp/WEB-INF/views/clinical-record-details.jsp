<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.fasterxml.jackson.databind.JsonNode,com.medcloud.course.portal.web.WebEscaper" %>
<%! private String value(javax.servlet.http.HttpServletRequest r,String key){Object v=r.getAttribute(key);return WebEscaper.html(v==null?"":String.valueOf(v));}
private String content(JsonNode n){StringBuilder h=new StringBuilder("<dl>");String[] keys={"complaint","diagnosis","advice","notes"},labels={"主诉","诊断","建议","备注"};for(int i=0;i<keys.length;i++)h.append("<dt>").append(labels[i]).append("</dt><dd><pre>").append(WebEscaper.html(n.path(keys[i]).asText(""))).append("</pre></dd>");return h.append("</dl>").toString();} %>
<% String context=request.getContextPath();boolean doctor="/doctor".equals(request.getAttribute("clinicalHome"));String home=doctor?"/doctor":"/patient";JsonNode details=(JsonNode)request.getAttribute("recordDetails"),history=(JsonNode)request.getAttribute("correctionPage");String query=(doctor?"recordId=":"appointmentId=")+value(request,"targetId"); %>
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>病历版本详情</title><link rel="stylesheet" href="<%= context %>/assets/course.css"></head><body><main class="container"><a href="<%= context+home %>">返回门户</a><h1>病历版本详情</h1>
<% if(request.getAttribute("clinicalError")!=null){ %><p role="alert"><%= value(request,"clinicalError") %></p><% } %>
<% if(details!=null){ %><section class="card"><h2>原始记录（版本0，永久保留）</h2><p>完成时间：<%= WebEscaper.html(details.path("completedAt").asText("历史时间未知")) %></p><%= content(details.path("original")) %></section><section class="card"><h2>当前有效版本</h2><p>版本 <%= WebEscaper.html(details.path("currentRevision").asText()) %></p><%= content(details.path("effective")) %></section><% } %>
<% if(doctor && Boolean.TRUE.equals(request.getAttribute("clinicalWritable"))){ %><a href="<%= context %>/doctor/correction?recordId=<%= value(request,"targetId") %>">追加病历更正</a><% } %>
<section class="card"><h2>更正历史</h2><p>每页最多5条完整前后版本。</p><% if(history!=null){for(JsonNode item:history.path("items")){ %><article><h3>更正序号 <%= WebEscaper.html(item.path("sequence").asText()) %></h3><p>医生 <%= WebEscaper.html(item.path("doctorId").asText()) %> · 时间 <%= WebEscaper.html(item.path("createdAt").asText()) %></p><h4>更正前</h4><%= content(item.path("before")) %><h4>更正后</h4><%= content(item.path("after")) %><h4>更正原因</h4><pre><%= WebEscaper.html(item.path("reason").asText()) %></pre></article><% }long p=history.path("page").asLong(1),size=history.path("pageSize").asLong(5),total=history.path("total").asLong();if(history.path("items").size()==0){ %><p>暂无更正记录。</p><% } %><nav aria-label="更正历史分页"><% if(p>1){ %><a href="<%= context+home %>/record-details?<%= query %>&amp;page=<%= p-1 %>&amp;pageSize=<%= size %>">上一页</a><% }if(p<Integer.MAX_VALUE && size>0 && p<total/size+(total%size>0?1:0)){ %><a href="<%= context+home %>/record-details?<%= query %>&amp;page=<%= p+1 %>&amp;pageSize=<%= size %>">下一页</a><% } %></nav><% } %></section></main></body></html>
