<%@ page pageEncoding="UTF-8" %>
<%@ page import="java.math.BigDecimal,java.math.RoundingMode" %>
<%!
  private String statisticsValue(JsonNode metrics, String field) {
    JsonNode value = metrics.path(field);
    if ("orderAmount".equals(field) || "paidRevenue".equals(field)) {
      try { return new BigDecimal(value.asText("0")).setScale(2, RoundingMode.HALF_UP).toPlainString(); }
      catch (NumberFormatException invalid) { return "—"; }
    }
    return WebEscaper.html(value.asText("0"));
  }

  private BigDecimal trendCount(JsonNode metrics) {
    try { return new BigDecimal(metrics.path("appointmentTotal").asText("0")).max(BigDecimal.ZERO); }
    catch (NumberFormatException invalid) { return BigDecimal.ZERO; }
  }

  private String trendWidth(JsonNode metrics, BigDecimal maximum) {
    if (maximum.signum() <= 0) return "0";
    return trendCount(metrics).min(maximum).multiply(new BigDecimal("100"))
        .divide(maximum, 2, RoundingMode.DOWN).stripTrailingZeros().toPlainString();
  }
%>
<% JsonNode statistics = (JsonNode) request.getAttribute("statistics");
   boolean platformStatistics = "platform".equals(workspace);
   String statisticsAnchor = platformStatistics ? "platform-statistics" : "hospital-statistics";
   String statisticsOtherFilters = platformStatistics ? "" : ordersQuery;
   if (platformStatistics) {
     try {
       int pageFilter = Integer.parseInt(attribute(request, "page")), sizeFilter = Integer.parseInt(attribute(request, "size"));
       if (pageFilter > 0 && sizeFilter > 0 && sizeFilter <= 100) statisticsOtherFilters = "page=" + pageFilter + "&size=" + sizeFilter;
     } catch (NumberFormatException invalid) { /* No unsafe pagination enters links. */ }
   }
   String[] metricFields = {"appointmentTotal", "appointmentBooked", "appointmentInProgress", "appointmentCanceled", "appointmentCompleted", "consultationStarted", "consultationCompleted", "orderGenerated", "orderAmount", "paidOrderCount", "paidRevenue"};
   String[] metricLabels = {"预约总数", "已预约", "接诊中预约", "已取消预约", "已完成预约", "开始接诊数", "完成诊疗数", "生成订单数", "应收金额（元）", "实收订单数", "模拟实收（元）"};
%>
<section class="card" id="<%= statisticsAnchor %>">
  <div class="section-heading"><div><p class="section-kicker"><%= platformStatistics ? "02 / PLATFORM STATISTICS" : "05 / HOSPITAL STATISTICS" %></p><h2><%= platformStatistics ? "跨院统计" : "本院统计" %></h2></div><span class="section-tag">脱敏汇总</span></div>
  <form method="get" action="<%= context %>/<%= workspace %>#<%= statisticsAnchor %>" class="inline-form" aria-describedby="statistics-filter-help">
    <%= hiddenFilters(statisticsOtherFilters) %>
    <label>统计开始日期<input type="date" name="statsFrom" value="<%= attribute(request, "statsFrom") %>" required></label>
    <label>统计结束日期<input type="date" name="statsTo" value="<%= attribute(request, "statsTo") %>" required></label>
    <button type="submit">查询统计</button>
    <a class="reset-link" href="<%= filteredUrl(context + "/" + workspace, statisticsOtherFilters, statisticsAnchor) %>">重置统计</a>
  </form>
  <p class="subtle" id="statistics-filter-help">默认近 30 天；起止日期均包含，请同时填写有效日期，最多 366 个自然日。</p>
  <%= sectionError(request, "statisticsError") %>
  <% if (statistics != null && request.getAttribute("statisticsError") == null) { %>
  <p class="statistics-range">统计范围：<strong><%= WebEscaper.html(statistics.path("from").asText()) %> — <%= WebEscaper.html(statistics.path("to").asText()) %></strong> · 时区 <%= WebEscaper.html(statistics.path("timezone").asText()) %><br><span class="note">生成时间：<%= WebEscaper.html(statistics.path("generatedAt").asText()) %>；数值按本次查询快照计算。</span></p>
  <% if (platformStatistics && statistics.path("tenantCounts").isObject()) { JsonNode counts = statistics.path("tenantCounts"); %>
  <p class="notice">医院存量：共 <%= WebEscaper.html(counts.path("total").asText()) %> 家 · 启用 <%= WebEscaper.html(counts.path("active").asText()) %> 家 · 停用 <%= WebEscaper.html(counts.path("disabled").asText()) %> 家。不受日期筛选影响。</p>
  <% } %>
  <div class="metrics-grid">
    <% for (int metricIndex = 0; metricIndex < metricFields.length; metricIndex++) { %>
    <div class="metric-card"><span><%= metricLabels[metricIndex] %></span><strong class="metric-value"><%= statisticsValue(statistics.path("metrics"), metricFields[metricIndex]) %></strong></div>
    <% } %>
  </div>
  <details class="statistics-definitions" open><summary>指标口径与时间依据</summary>
    <p>预约总数按下单日期 booked_on 筛选，包含后来取消的预约；四状态为这个预约群体在查询时的当前状态，不是状态转换当日数量。</p>
    <p>开始接诊数按 started_at，完成诊疗数按病历 completed_at。生成订单及应收金额按关联病历 completed_at；实收订单及模拟实收按 PAID 订单 paid_at。</p>
    <p>已完成预约与完成诊疗分别属于下单群体和完成事件；应收金额与模拟实收也可能来自不同日期的订单，不能互换。每日指标合计等于区间指标，停用及零业务医院仍纳入统计。</p>
  </details>
  <div class="result"><h3>历史时间未知：全量补充说明，不属于所选区间</h3>
    <% JsonNode unknown = statistics.path("legacyUnknownTime"); %>
    <p>开始时间未知的预约：<%= statisticsValue(unknown, "startedAppointments") %>；完成时间未知的病历：<%= statisticsValue(unknown, "completedRecords") %>。</p>
    <p>生成时间未知的订单：<%= statisticsValue(unknown, "generatedOrders") %>，应收 ¥<%= statisticsValue(unknown, "orderAmount") %>；支付时间未知的已付订单：<%= statisticsValue(unknown, "paidOrders") %>，模拟实收 ¥<%= statisticsValue(unknown, "paidRevenue") %>。</p>
    <p class="note">不补造旧时间，不加入区间合计。同一记录可能影响多项提示，各项不可相加作为记录总数。</p>
  </div>
  <% if (statistics.path("hospitals").isArray()) { %>
  <h3><%= platformStatistics ? "分医院汇总" : "本院状态与汇总" %></h3>
  <div class="table-wrap" tabindex="0" role="region" aria-label="医院统计汇总，左右滚动查看更多"><table><thead><tr><th>医院编号</th><th>医院名称</th><th>医院状态</th><% for (String label : metricLabels) { %><th><%= label %></th><% } %></tr></thead><tbody>
    <% for (JsonNode hospitalStatistics : statistics.path("hospitals")) { JsonNode statisticsTenant = hospitalStatistics.path("tenant"); %>
    <tr><td class="identifier"><%= WebEscaper.html(statisticsTenant.path("id").asText()) %></td><td><%= WebEscaper.html(statisticsTenant.path("name").asText()) %></td><td><%= stateBadge(statisticsTenant.path("status").asText()) %></td>
      <% for (String field : metricFields) { %><td><%= statisticsValue(hospitalStatistics.path("metrics"), field) %></td><% } %></tr>
    <% } %>
  </tbody></table></div>
  <% } } else if (request.getAttribute("statisticsError") == null) { %><p class="empty-state">统计尚未加载，请刷新后重试。</p><% } %>
</section>
<section class="card" id="daily-trend">
  <div class="section-heading"><div><p class="section-kicker"><%= platformStatistics ? "03 / DAILY TREND" : "06 / DAILY TREND" %></p><h2>每日趋势</h2></div></div>
  <p class="subtle">表格提供完整精确值，日期按升序列出并补齐零值；条形仅辅助比较每日预约总数。可聚焦表格，用键盘滚动。</p>
  <% if (statistics != null && request.getAttribute("statisticsError") == null && statistics.path("daily").isArray()) {
     BigDecimal trendMaximum = BigDecimal.ZERO;
     for (JsonNode day : statistics.path("daily")) trendMaximum = trendMaximum.max(trendCount(day.path("metrics"))); %>
  <div class="table-wrap daily-trend-table" tabindex="0" role="region" aria-label="每日趋势，横向和纵向滚动查看更多"><table><caption>每日预约、诊疗及订单统计（金额单位：人民币元）</caption><thead><tr><th>日期</th><th>预约条形</th><% for (String label : metricLabels) { %><th><%= label %></th><% } %></tr></thead><tbody>
    <% for (JsonNode day : statistics.path("daily")) { %>
    <tr data-trend-date="<%= WebEscaper.html(day.path("date").asText()) %>"><th scope="row"><%= WebEscaper.html(day.path("date").asText()) %></th><td><span class="trend-track" aria-hidden="true"><span class="trend-bar" style="width:<%= trendWidth(day.path("metrics"), trendMaximum) %>%"></span></span></td>
      <% for (String field : metricFields) { %><td><%= statisticsValue(day.path("metrics"), field) %></td><% } %></tr>
    <% } %>
  </tbody></table></div>
  <% } else { %><p class="empty-state">每日趋势暂不可用，统计查询成功后显示。</p><% } %>
</section>
