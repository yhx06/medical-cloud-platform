<%@ page pageEncoding="UTF-8" %>
<%@ page import="com.medcloud.course.portal.web.WebEscaper" %>
<%@ include file="status.jspf" %>
<%!
  private String auditFilters(javax.servlet.http.HttpServletRequest request, String workspace) {
    if (request.getAttribute("auditPage") == null && request.getAttribute("auditError") == null) return "";
    final java.util.Map<String,String[]> values = new java.util.LinkedHashMap<String,String[]>();
    for (String field : new String[]{"auditFrom", "auditTo", "auditEventType", "auditResult", "auditPage", "auditSize", "auditTenantId"}) {
      String value = attribute(request, "auditPage".equals(field) ? "auditPageNumber" : field);
      if (!value.isEmpty()) values.put(field, new String[]{value});
    }
    javax.servlet.http.HttpServletRequest view = new javax.servlet.http.HttpServletRequestWrapper(request) {
      public java.util.Map<String,String[]> getParameterMap() { return values; }
      public String[] getParameterValues(String name) { return values.get(name); }
      public String getParameter(String name) { return values.containsKey(name) ? values.get(name)[0] : null; }
    };
    try {
      String query = com.medcloud.course.portal.web.AuditWorkspace.query(view, "platform".equals(workspace)
          ? com.medcloud.course.contract.Role.PLATFORM_ADMIN : com.medcloud.course.contract.Role.HOSPITAL_ADMIN).substring(1);
      StringBuilder prefixed = new StringBuilder();
      for (String pair : query.split("&")) {
        String[] p = pair.split("=", 2); if (prefixed.length() > 0) prefixed.append('&');
        prefixed.append("audit").append(Character.toUpperCase(p[0].charAt(0))).append(p[0].substring(1)).append('=').append(p[1]);
      }
      return prefixed.toString();
    } catch (IllegalArgumentException invalid) { return ""; }
  }
  private String joinFilters(String a, String b) { return a.isEmpty() ? b : b.isEmpty() ? a : a + "&" + b; }
%>
<% String context = request.getContextPath();
   String statsQuery = statisticsFilters(request), ordersQuery = orderFilters(request);
   String auditQuery = auditFilters(request, workspace);
   com.fasterxml.jackson.databind.JsonNode hospitalContext = (com.fasterxml.jackson.databind.JsonNode) request.getAttribute("hospitalContext");
   boolean workspaceWritable = Boolean.TRUE.equals(request.getAttribute("businessWritable"))
       && hospitalContext != null && "ACTIVE".equals(hospitalContext.path("status").asText()); %>
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= WebEscaper.html(String.valueOf(request.getAttribute("portalTitle"))) %> · 医疗云</title>
  <link rel="stylesheet" href="<%= context %>/assets/course.css">
  <link rel="stylesheet" href="<%= context %>/assets/lab2-portal.css">
  <script src="<%= context %>/assets/portal.js" defer></script>
</head>
<body class="workspace-page">
<a class="skip-link" href="#main-content">跳转到主要内容</a>
<header class="topbar portal-header">
  <a class="brand" href="<%= context %>/<%= workspace %>"><span class="brand-mark" aria-hidden="true">+</span><span>智慧医疗云<small>在线预约与诊疗服务平台</small></span></a>
  <div class="account" role="group" aria-label="当前账号"><span class="account-role"><%= workspaceLabel %></span><span class="account-avatar" aria-hidden="true">云</span><span class="account-name"><%= WebEscaper.html(String.valueOf(request.getAttribute("username"))) %></span><a class="logout-link" href="<%= context %>/logout">退出登录</a></div>
</header>
<nav class="service-portfolio" aria-label="用户服务菜单">
  <div class="portfolio-inner"><span class="portfolio-name"><svg class="service-icon" aria-hidden="true"><use href="<%= context %>/assets/icons.svg#cloud"/></svg>医疗云服务</span><a href="<%= context %>/<%= workspace %>" aria-current="page"><%= workspaceLabel %>工作台</a><a href="#service-scope">服务说明</a><span class="portfolio-caption">预约 · 诊疗 · 医院协同</span></div>
</nav>
<div class="app-shell">
<aside class="sidebar">
  <div class="sidebar-label"><span>内容导航</span><small><%= workspaceLabel %></small></div>
  <nav class="workspace-nav" aria-label="工作台导航">
    <% if ("patient".equals(workspace)) { %>
    <a href="#slot-search"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#calendar"/></svg>预约挂号</a>
    <a href="#appointment-history"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#appointments"/></svg>我的预约</a>
    <a href="#record-billing"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#document"/></svg>病历与账单</a>
    <% } else if ("doctor".equals(workspace)) { %>
    <a href="#consultations"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#consultation"/></svg>接诊工作台</a>
    <a href="#clinical-history"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#document"/></svg>病历记录</a>
    <a href="#doctor-profile"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#profile"/></svg>个人资料</a>
    <% } else if ("hospital".equals(workspace)) { %>
    <a href="#hospital-profile"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#building"/></svg>医院资料</a>
    <a href="#departments"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#grid"/></svg>科室管理</a>
    <a href="#doctors"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#profile"/></svg>医生管理</a>
    <a href="#schedule"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#calendar"/></svg>排班号源</a>
    <a href="#orders"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#billing"/></svg>诊疗账单</a>
    <a href="#hospital-statistics"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#chart"/></svg>本院统计</a>
    <a href="#daily-trend"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#activity"/></svg>每日趋势</a>
    <a href="#audit-events"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#shield"/></svg>本院审计</a>
    <% } else { %>
    <a href="#tenant-management"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#building"/></svg>医院管理</a>
    <a href="#platform-statistics"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#chart"/></svg>跨院统计</a>
    <a href="#daily-trend"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#activity"/></svg>每日趋势</a>
    <a href="#audit-events"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#shield"/></svg>平台审计</a>
    <a href="#architecture"><svg class="nav-icon" aria-hidden="true" focusable="false"><use href="<%= context %>/assets/icons.svg#layers"/></svg>架构概览</a>
    <% } %>
  </nav>
  <div class="sidebar-note"><svg class="service-icon" aria-hidden="true"><use href="<%= context %>/assets/icons.svg#shield"/></svg><strong>服务小提示</strong><p><% if ("patient".equals(workspace)) { %>先选择医院和科室，再查询医生号源。预约后的诊疗信息可在本人记录中查阅。<% } else if ("doctor".equals(workspace)) { %>从接诊工作台开始处理本院预约，保存草稿后可继续完善诊疗记录。<% } else if ("hospital".equals(workspace)) { %>按科室、医生、排班的顺序维护本院服务资源。<% } else { %>管理入驻医院，查看脱敏统计与审计信息。<% } %></p></div>
</aside>
<div class="workspace-content">
<main class="container" id="main-content" tabindex="-1">
  <div class="breadcrumb">医疗云服务 <span>/</span> <%= workspaceLabel %> <span>/</span> 服务工作区</div>
  <div class="page-heading portal-welcome"><div><p class="eyebrow">智慧医疗云 · <%= workspaceLabel %></p><h1><%= WebEscaper.html(String.valueOf(request.getAttribute("portalTitle"))) %></h1><p class="page-description"><%= workspaceDescription %></p></div><span class="welcome-icon" aria-hidden="true"><svg><use href="<%= context %>/assets/icons.svg#<%= "doctor".equals(workspace) ? "consultation" : "patient".equals(workspace) ? "calendar" : "building" %>"/></svg></span></div>
  <% if (request.getAttribute("notice") != null) { %><p class="notice" role="status"><%= request.getAttribute("notice") %></p><% } %>
  <% if (request.getAttribute("error") != null) { %><p class="error" role="alert"><%= request.getAttribute("error") %></p><% } %>
  <% if (("doctor".equals(workspace) || "hospital".equals(workspace)) && !workspaceWritable) { %>
  <p class="notice read-only-notice" role="status"><%= readOnlyReason(hospitalContext == null ? "" : hospitalContext.path("status").asText()) %></p>
  <% } %>
